// This Prisma schema defines the data model for the credit dashboard.
// SQLite is used in development; Postgres should be used in production.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = env("DB_PROVIDER")
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
  CLIENT
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      Role     @default(CLIENT)
  clients   Client[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Client {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  firstName String
  middleName String?
  lastName  String
  dob       DateTime?
  email     String?
  phone     String?
  address   String?
  documents Document[]
  scores    BureauScore[]
  paymentMethods PaymentMethod[]
  disputes  Dispute[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Document {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id])
  type      String
  bureau    String?
  filename  String
  path      String
  metadata  Json?
  createdAt DateTime @default(now())
}

model BureauScore {
  id            String   @id @default(cuid())
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id])
  bureau        String
  score         Int
  scoreDate     DateTime
  sourceDocumentId String
  document      Document @relation(fields: [sourceDocumentId], references: [id])
  createdAt     DateTime @default(now())
}

model Dispute {
  id         String     @id @default(cuid())
  clientId   String
  client     Client     @relation(fields: [clientId], references: [id])
  company    String
  reference  String
  value      Float
  status     String
  activities Activity[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Activity {
  id        String   @id @default(cuid())
  disputeId String
  dispute   Dispute  @relation(fields: [disputeId], references: [id])
  date      DateTime
  entity    String
  action    String
  result    String
  createdAt DateTime @default(now())
}

model PaymentMethod {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id])
  name      String
  last4     String
  expMonth  Int
  expYear   Int
  createdAt DateTime @default(now())
}